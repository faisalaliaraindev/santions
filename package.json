{
  "name": "erly-adverse-search",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone adverse-media search service. Free and open-source sources only.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p packages/domain/tsconfig.json && tsc -p packages/evaluation/tsconfig.json && tsc -p packages/contracts/tsconfig.json && tsc -p packages/client/tsconfig.json && tsc -p apps/api/tsconfig.json && tsc -p tsconfig.json",
    "test:unit": "vitest run --project unit",
    "test:invariants": "vitest run --project invariants",
    "test:evaluation": "vitest run --project evaluation",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:e2e": "echo \"[pending G8] e2e suite not implemented\" && exit 1",
    "test:load": "echo \"[pending G11] k6 load suite not implemented\" && exit 1",
    "verify:local": "node scripts/verify-local.mjs",
    "openapi:generate": "pnpm build && node scripts/generate-openapi.mjs",
    "local:up": "node scripts/local-up.mjs",
    "local:down": "docker compose -f infra/local/docker-compose.yml down",
    "local:reset": "node scripts/local-reset.mjs",
    "local:bootstrap": "node scripts/local-bootstrap.mjs",
    "dev": "node scripts/dev.mjs",
    "demo:api": "pnpm build && node scripts/demo-api.mjs",
    "demo:zquence": "echo \"[pending G9] zquence demo not implemented\" && exit 1",
    "lexicon:audit": "vitest run --project unit packages/domain/test/taxonomy/lexicon-audit.test.ts",
    "dev:api": "pnpm build && node apps/api/dist/main.js",
    "dev:worker": "pnpm build && node apps/api/dist/worker-main.js",
    "bench:search-index": "pnpm build && node scripts/workload/search-index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4",
    "jose": "^5.9.6",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@nestjs/testing": "^11.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "mongodb": "^6.12.0",
    "zod": "^3.24.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "mongodb": "^6.12.0"
  }
}
