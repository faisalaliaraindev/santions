# Copy to .env.local for development. Never commit a real secret.
#
# The control panel holds no secrets. It authenticates through the API's
# backend-for-frontend session, so provider tokens and machine credentials
# never reach the browser bundle (section 4.2).

# The API origin. In development, Vite proxies /v1 and /auth here so the
# session cookie stays same-origin.
VITE_API_ORIGIN=http://127.0.0.1:3000

# Shown in the header so a mock-mode run can never be mistaken for a live one (T55).
VITE_ENVIRONMENT_LABEL=local
