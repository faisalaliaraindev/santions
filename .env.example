# Copy to .env for local development. Never commit a real secret.
# Every value here is a local-development placeholder; production supplies its own through
# a secret reference, not through this file.

# ---------------------------------------------------------------------------
# Mode. `mock` uses the fixture server only and makes no external call.
# `live` requires configured source access and owner authorisation.
# ---------------------------------------------------------------------------
ADVERSE_SEARCH_MODE=mock
NODE_ENV=development

# ---------------------------------------------------------------------------
# MongoDB. A replica set is required: transactions are used for the
# state/outbox/audit commit and a standalone mongod cannot do them.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:28017/adverse_search?replicaSet=rs0&directConnection=true

# ---------------------------------------------------------------------------
# Search index. Working assumption; open decision D12 settles this at G4.
# ---------------------------------------------------------------------------
SEARCH_INDEX_KIND=meilisearch
MEILI_HOST=http://127.0.0.1:28700
MEILI_MASTER_KEY=local-development-master-key-change-me

# ---------------------------------------------------------------------------
# S3 and SQS via LocalStack. Local emulation is not evidence that real AWS
# IAM and KMS policies work (SEC-03) — that is verified separately at G11.
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-2
AWS_ENDPOINT_URL=http://127.0.0.1:28566
# ---------------------------------------------------------------------------
# The jobs queue (LocalStack SQS), created by `pnpm local:bootstrap`.
#
# Without these the API and the worker each fall back to their OWN in-process
# queue: the API publishes into its own memory and the worker polls an empty
# one, so an accepted search stays QUEUED forever and nothing says why. Both
# processes log a warning about it, which is easy to read past.
# ---------------------------------------------------------------------------
JOBS_QUEUE_URL=http://127.0.0.1:28566/000000000000/adverse-search-jobs
JOBS_DEAD_LETTER_QUEUE_URL=http://127.0.0.1:28566/000000000000/adverse-search-jobs-dlq

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_EVIDENCE_BUCKET=adverse-search-evidence-local
SQS_QUEUE_URL=http://127.0.0.1:28566/000000000000/adverse-search-jobs
SQS_DLQ_URL=http://127.0.0.1:28566/000000000000/adverse-search-jobs-dlq

# ---------------------------------------------------------------------------
# OIDC. Production startup rejects this issuer, insecure cookies and seed
# accounts (T09).
# ---------------------------------------------------------------------------
OIDC_ISSUER=http://127.0.0.1:28080/realms/adverse-search-local
OIDC_CLIENT_ID=adverse-search-panel
OIDC_CLIENT_SECRET=local-development-only
SESSION_COOKIE_SECURE=false
SESSION_SECRET=local-development-session-secret-change-me

# ---------------------------------------------------------------------------
# Discovery. Rungs 0-6 of the cascade. All free; keys are free-tier where
# required. Leave blank in mock mode.
# ---------------------------------------------------------------------------
SEARXNG_URL=http://127.0.0.1:28888
FIXTURE_SERVER_URL=http://127.0.0.1:28090
# Free-key sources. Blank means the source is unconfigured and reports as a
# coverage gap — never as a zero result.
COMPANIES_HOUSE_API_KEY=

SEC_EDGAR_USER_AGENT=
COURTLISTENER_API_TOKEN=

# ---------------------------------------------------------------------------
# Extraction model. Self-hosted open weights only; a hosted third-party model
# endpoint is not permitted. Which model is open decision D7.
# ---------------------------------------------------------------------------
EXTRACTION_MODEL_KIND=synthetic
MODEL_RUNTIME_URL=http://127.0.0.1:28434
EXTRACTION_MODEL_ID=

# ---------------------------------------------------------------------------
# Outbound identification. The user agent identifies the service honestly with
# a contact URL (FR-06 hard constraints).
# ---------------------------------------------------------------------------
# Phase E step 1 replaced the unused OUTBOUND_USER_AGENT placeholder that stood
# here. It was read by nothing, and a free-text user agent can be set to a string
# with no contact URL in it at all — which is the dishonest case the requirement
# forbids. The contact URL is configured instead, validated as a URL, and the
# user agent is built from it, so an honest one is the only one that exists.
#
# Blank means the live fetch adapter is NOT constructed: an anonymous crawler is
# not a degraded version of an honest one. Nothing outbound happens in mock mode
# regardless of this value.
FETCH_CONTACT_URL=https://erlystage.com/bots/adverse-search

# ---------------------------------------------------------------------------
# Customer-facing links (phase I step I2)
# ---------------------------------------------------------------------------
# Where a customer's browser reaches the control panel. Used to build the links
# in email-verification and password-reset messages.
#
# Optional, and deliberately not guessed at: with no value, those emails carry
# the token and the endpoint to send it to instead. A link to the wrong host is
# worse than no link, because the customer cannot tell it is wrong.
#
# Deliberately NOT derived from CORS_ORIGINS. That list says who may call this
# API, which is a different question from where the customer's interface lives.
PUBLIC_APP_URL=

# NOTE: no mail transport is configured anywhere yet. On a local stack, every
# message is written to the `outboundEmails` collection and logged — that
# collection is the inbox. Production REFUSES to send at all rather than
# pretending: a no-op mailer is how a service ends up with a signup flow that
# looks healthy and a customer base nobody can reach.
