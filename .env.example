# Copy to .env for local development. Never commit a real secret.
# Every value here is a local-development placeholder; production supplies its own through
# a secret reference, not through this file.

# ---------------------------------------------------------------------------
# Mode. `mock` uses the fixture server only and makes no external call.
# `live` requires configured source access and owner authorisation.
# ---------------------------------------------------------------------------
ADVERSE_SEARCH_MODE=mock
NODE_ENV=development

# ---------------------------------------------------------------------------
# MongoDB. A replica set is required: transactions are used for the
# state/outbox/audit commit and a standalone mongod cannot do them.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:28017/adverse_search?replicaSet=rs0&directConnection=true

# ---------------------------------------------------------------------------
# Search index. Working assumption; open decision D12 settles this at G4.
# ---------------------------------------------------------------------------
SEARCH_INDEX_KIND=meilisearch
MEILI_HOST=http://127.0.0.1:28700
MEILI_MASTER_KEY=local-development-master-key-change-me

# ---------------------------------------------------------------------------
# S3 and SQS via LocalStack. Local emulation is not evidence that real AWS
# IAM and KMS policies work (SEC-03) — that is verified separately at G11.
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-2
AWS_ENDPOINT_URL=http://127.0.0.1:28566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_EVIDENCE_BUCKET=adverse-search-evidence-local
SQS_QUEUE_URL=http://127.0.0.1:28566/000000000000/adverse-search-jobs
SQS_DLQ_URL=http://127.0.0.1:28566/000000000000/adverse-search-jobs-dlq

# ---------------------------------------------------------------------------
# OIDC. Production startup rejects this issuer, insecure cookies and seed
# accounts (T09).
# ---------------------------------------------------------------------------
OIDC_ISSUER=http://127.0.0.1:28080/realms/adverse-search-local
OIDC_CLIENT_ID=adverse-search-panel
OIDC_CLIENT_SECRET=local-development-only
SESSION_COOKIE_SECURE=false
SESSION_SECRET=local-development-session-secret-change-me

# ---------------------------------------------------------------------------
# Discovery. Rungs 0-6 of the cascade. All free; keys are free-tier where
# required. Leave blank in mock mode.
# ---------------------------------------------------------------------------
SEARXNG_URL=http://127.0.0.1:28888
FIXTURE_SERVER_URL=http://127.0.0.1:28090
# Free-key sources. Blank means the source is unconfigured and reports as a
# coverage gap — never as a zero result.
COMPANIES_HOUSE_API_KEY=
SEC_EDGAR_USER_AGENT=
COURTLISTENER_API_TOKEN=

# ---------------------------------------------------------------------------
# Extraction model. Self-hosted open weights only; a hosted third-party model
# endpoint is not permitted. Which model is open decision D7.
# ---------------------------------------------------------------------------
EXTRACTION_MODEL_KIND=synthetic
MODEL_RUNTIME_URL=http://127.0.0.1:28434
EXTRACTION_MODEL_ID=

# ---------------------------------------------------------------------------
# Outbound identification. The user agent identifies the service honestly with
# a contact URL (FR-06 hard constraints).
# ---------------------------------------------------------------------------
OUTBOUND_USER_AGENT="ErlyAdverseSearch/0.1 (+https://erlystage.com/bots/adverse-search)"
